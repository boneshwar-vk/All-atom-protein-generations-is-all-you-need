# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments
.venv/
venv/
env/

# uv
# (uv.lock IS committed; the virtualenv is not)

# Experiment / run outputs
experiments/**/outputs/
experiments/**/logs/
experiments/**/checkpoints/
outputs/
multirun/
wandb/
mlruns/
*.log
# Structure-predictor scratch (scorers default to a temp dir, but a pinned work_dir may land here)
boltz_runs/
protenix_runs/

# Data & weights (tracked only via manifests; weights themselves are never committed)
data/*
!data/README.md
# Keep the weights-directory doc, but not its contents.
!data/weights/
data/weights/*
!data/weights/README.md
*.pt
*.ckpt
*.pth
*.npz
*.h5
# Exception: the vendored ProteinMPNN weights ARE committed (small, MIT-licensed). See
# VENDORING.md and packages/proteinmpnn/LICENSE.
!packages/proteinmpnn/src/proteinmpnn/vendor/**/*.pt

# Editors / OS
.idea/
.vscode/
.DS_Store
