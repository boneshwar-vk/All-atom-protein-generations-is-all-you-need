# NOTE: git-LFS is NOT used (not enabled on the remote). Large weights are normally fetched via
# scripts/download_weights.py and NOT committed; the one exception is the small, MIT-licensed
# vendored ProteinMPNN weights, which are committed as ordinary git blobs.
*.pt    binary
*.pth   binary
*.ckpt  binary
*.npz   binary

# Keep text files normalized.
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
